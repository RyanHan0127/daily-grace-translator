# Copy this file to `.env` in the same folder and fill in both values.
#
# GMAIL_APP_PASSWORD is a 16-character Google App Password from
# https://myaccount.google.com/apppasswords -- NOT your account password.
# Requires 2-Step Verification to be enabled first.
#
# The spaces Google shows between groups of four are cosmetic; paste it with
# or without them, the script strips them either way.

GMAIL_ADDRESS=your.address@gmail.com
GMAIL_APP_PASSWORD=

# OPTIONAL. Only affects `python3 daily_grace.py` (the standalone path).
# Leave blank to use the free, unofficial Google Translate endpoint -- no signup,
# but Google may throttle or change it without notice.
# Set a Google Cloud Translation API key here to use the official API instead:
# https://console.cloud.google.com/apis/library/translate.googleapis.com
# Its free tier is 500K characters/month; this uses roughly 6K per day.
GOOGLE_TRANSLATE_API_KEY=
